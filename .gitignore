# ── СЕКРЕТЫ — никогда не коммитим! ──
.env
.env.*
!.env.example

# ── Локальная БД и бэкапы — у каждого свои ──
*.db
*.db-journal
*.db-shm
*.db-wal
data/tracker.db*
data/backups/

# Файл-замок работающего трекера: держится процессом, git его не прочитает.
data/tracker.lock

# ── Whitelist коммитим (это часть конфигурации стратегии).
#    Если захочешь скрыть — раскомментируй:
# data/whitelist.txt

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# ── IDE ──
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Результат замера источников: выводится из БД, у каждого свой.
data/funders.json

# ── Логи ──
*.log
logs/

# ── Архив (исходный zip лежит локально, в репо не нужен) ──
archive/*.zip
