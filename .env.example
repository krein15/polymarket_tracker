# ═══════════════════════════════════════════════════════════════
#  Polymarket Tracker — пример конфига.
#  Скопируй в .env и заполни первые два поля:
#      copy .env.example .env
#  .env в git НЕ попадает (см. .gitignore).
# ═══════════════════════════════════════════════════════════════

# ── Telegram (обязательно) ──
# Токен от @BotFather, chat_id из https://api.telegram.org/bot<ТОКЕН>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Data API (источник сделок) ──
DATA_API_POLL_INTERVAL=15.0       # сек между дешёвыми проверками головы API
DATA_API_BATCH_LIMIT=10000        # ВАЖНО: Data API публикует сделки пачками
                                  # раз в ~5 минут (~7800 сделок за раз). Окно
                                  # меньше пачки = молчаливая потеря сделок:
                                  # на 200 терялось 83%. Не понижай без замера.

# ── Фильтры Ветки A (suspicious entry / cluster) ──
MIN_TRADE_USDC=2000.0             # стартовый порог; через 2-4 недели можно снизить
MAX_TRADE_PRICE=0.95              # отсекаем "почти решённые" рынки (ROI < спреда)
MAX_MARKET_VOLUME_24H=50000.0     # отсекаем ликвидные рынки
NEW_WALLET_MAX_TRADES=20
NEW_WALLET_MAX_AGE_DAYS=30
CLUSTER_MIN_WALLETS=3             # на старте 3, после накопления БД — 2
CLUSTER_WINDOW_SECONDS=3600
IGNORED_CATEGORIES=crypto,sports
# Исключения из фильтра выше: киберспортивные рынки помечены тегами
# {esports, sports, ...} одновременно, поэтому вернуть только их можно
# лишь явным разрешением. Пусто = исключений нет.
ALLOWED_TAGS=

# ── Скоринг (взвешенная оценка вместо жёсткой цепочки И, см. scoring.py) ──
# Сигнал уходит, когда сумма баллов по признакам выше порога. Разбивка по
# баллам пишется и в сигналы, и в теневую выборку — по ней порог и калибруется
# (tools/shadow_report.py --by-score). 58 — не догадка, а замер:
# tools/calibrate_score.py на первых данных дал при нём ~3 сигнала в час.
# ВАЖНО: примерно через 3 дня работы включатся признаки кошелька
# (новизна, кластер) — баллы вырастут, порог надо будет поднять.
# Перекалибровать: python tools/calibrate_score.py
SCORING_ENABLED=1
SCORE_THRESHOLD=58
SCORING_MIN_TRADE_USDC=200        # ниже этого размера сделку вообще не оцениваем
ACCUMULATION_WINDOW_SECONDS=1800  # окно, в котором покупки считаются набором одной позиции

# ── Ветка B (whitelist / copy-trading) ──
WHITELIST_FILE=data/whitelist.txt
WHITELIST_MIN_USDC=200.0

# ── Shadow tracker (измерение false negatives фильтров Ветки A) ──
# Должен быть >= MAX_MARKET_VOLUME_24H, иначе выборка не накроет боевые сигналы.
SHADOW_ENABLED=1
SHADOW_MAX_VOLUME_24H=500000.0

# ── Хранилище и логи ──
DB_PATH=data/tracker.db
LOG_LEVEL=INFO
