# Нормализация переводов строк: в репозитории LF, в рабочей копии — как принято в ОС.
* text=auto

# .bat cmd читает в кодировке консоли Windows (CP866): в UTF-8 он ломает
# разбор файла на кириллице. В репозитории при этом храним UTF-8, иначе на
# GitHub комментарии и echo выглядят кракозябрами. working-tree-encoding
# делает перекодировку автоматически при checkout/commit.
*.bat text eol=crlf working-tree-encoding=CP866

# Бинарь — не диффать и не трогать переводы строк.
*.zip binary
*.db binary
