# ═══════════════════════════════════════════════════════════════
#  Polymarket Tracker — пример конфига.
#  Скопируй в .env и заполни первые два поля:
#      copy .env.example .env
#  .env в git НЕ попадает (см. .gitignore).
# ═══════════════════════════════════════════════════════════════

# ── Telegram (обязательно) ──
# Токен от @BotFather, chat_id из https://api.telegram.org/bot<ТОКЕН>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Data API (источник сделок) ──
DATA_API_POLL_INTERVAL=15.0       # сек между дешёвыми проверками головы API
DATA_API_BATCH_LIMIT=10000        # ВАЖНО: Data API публикует сделки пачками
# Сколько страниц догружать назад, пока не дойдём до чекпоинта. Одна
# страница в 10000 сделок покрывает ~8 минут потока, а простои бывают
# длиннее: без догрузки разрыв отсекался молча.
DATA_API_MAX_PAGES=6
                                  # раз в ~5 минут (~7800 сделок за раз). Окно
                                  # меньше пачки = молчаливая потеря сделок:
                                  # на 200 терялось 83%. Не понижай без замера.

# ── Фильтры Ветки A (suspicious entry / cluster) ──
MIN_TRADE_USDC=2000.0             # стартовый порог; через 2-4 недели можно снизить
MAX_TRADE_PRICE=0.95              # отсекаем "почти решённые" рынки (ROI < спреда)
MAX_MARKET_VOLUME_24H=50000.0     # отсекаем ликвидные рынки
NEW_WALLET_MAX_TRADES=20
NEW_WALLET_MAX_AGE_DAYS=30
CLUSTER_MIN_WALLETS=3             # на старте 3, после накопления БД — 2
CLUSTER_WINDOW_SECONDS=3600
IGNORED_CATEGORIES=crypto,sports
# Исключения из фильтра выше: киберспортивные рынки помечены тегами
# {esports, sports, ...} одновременно, поэтому вернуть только их можно
# лишь явным разрешением. Пусто = исключений нет.
ALLOWED_TAGS=

# ── Скоринг (взвешенная оценка вместо жёсткой цепочки И, см. scoring.py) ──
# Сигнал уходит, когда сумма баллов по признакам выше порога. Разбивка по
# баллам пишется и в сигналы, и в теневую выборку — по ней порог и калибруется
# (tools/shadow_report.py --by-score). 58 — не догадка, а замер:
# tools/calibrate_score.py на первых данных дал при нём ~3 сигнала в час.
# ВАЖНО: примерно через 3 дня работы включатся признаки кошелька
# (новизна, кластер) — баллы вырастут, порог надо будет поднять.
# Перекалибровать: python tools/calibrate_score.py
SCORING_ENABLED=1
# Порог = МАКСИМУМ из этого пола и доли от достижимого максимума.
# Пол низкий сознательно: если история кошелька из API недоступна,
# достижимый максимум падает со 120 до 70, и высокий пол глушит всё.
SCORE_THRESHOLD=40
SCORE_THRESHOLD_RATIO=0.4

# Минимальная сумма, чтобы сигнал вообще отправился. Считается по НАКОПЛЕННОМУ
# за окно, а не по одной покупке: набор позиции частями не теряем.
# Замер: при 2000 выходило ~2 сигнала в час, при 5000 — около одного.
# Хочешь больше потока — снижай, это загрузочная настройка.
SIGNAL_MIN_USDC=5000

# Вклад участника, чтобы попасть в кластер. Раньше кластер считал "новые"
# кошельки по локальной базе, но 86% адресов в ней имеют меньше 20 сделок —
# признак означал просто "несколько участников" и держал 82% всех сигналов.
CLUSTER_MIN_PARTICIPANT_USDC=500


# История кошелька из Data API вместо ожидания локальной: снимает
# холодный старт признаков новизны, кластера и пробуждения.
WALLET_HISTORY_ENABLED=1
WALLET_HISTORY_TTL_SECONDS=21600
WALLET_HISTORY_CONCURRENCY=3

# Сигнал жизни. Ежедневная сводка в Telegram: пропала сводка - трекер умер.
# Отдельно сторож потока: если новых сделок нет дольше STALL_ALERT_MINUTES,
# придёт предупреждение (обычная пауза - 5 минут, столько копится пачка).
# Подтверждение погоней: сигнал приходит через CHASE_WINDOW_MINUTES после
# сделки, если следом в тот же исход зашли другие И заплатили заметно дороже.
# Замер: погоня свыше +15% при деньгах последователей от $2000 дала перевес
# +35.7 пп — сильнее всего остального. Признак запаздывающий: цена к моменту
# сигнала уже ушла вверх, это подтверждение, а не предсказание.
# Быстрая полоса из блокчейна. Голова цепочки отстаёт на ~1 секунду против
# 250-380 с у Data API. В группе "рынок побежал" за первые пять минут уходит
# четверть движения, то есть фора стоит около 16% цены.
# Включается только при заданном ALCHEMY_WSS_URL.
ONCHAIN_ENABLED=1
ONCHAIN_MIN_USDC=5000
ONCHAIN_MIN_IMPACT=0.20
ONCHAIN_MAX_PER_HOUR=4

# Общий потолок сообщений в час поверх ВСЕХ веток - последний рубеж
# против спама, не зависящий от калибровки отдельных порогов.
TELEGRAM_MAX_PER_HOUR=15

CHASE_ENABLED=1
CHASE_WINDOW_MINUTES=20
CHASE_MIN_RATIO=0.25
CHASE_MIN_MONEY_USDC=25000
# Жёсткий предел отправок в час и окно свежести (см. confirmation.py)
CHASE_MAX_PER_HOUR=3
CHASE_FRESH_MINUTES=30

HEARTBEAT_ENABLED=1
HEARTBEAT_INTERVAL_HOURS=24
STALL_ALERT_MINUTES=20
SCORING_MIN_TRADE_USDC=200        # ниже этого размера сделку вообще не оцениваем
ACCUMULATION_WINDOW_SECONDS=1800  # окно, в котором покупки считаются набором одной позиции

# ── Ветка B (whitelist / copy-trading) ──
WHITELIST_FILE=data/whitelist.txt
WHITELIST_MIN_USDC=200.0

# ── Shadow tracker (измерение false negatives фильтров Ветки A) ──
# Должен быть >= MAX_MARKET_VOLUME_24H, иначе выборка не накроет боевые сигналы.
SHADOW_ENABLED=1
SHADOW_MAX_VOLUME_24H=500000.0

# ── Хранилище и логи ──
DB_PATH=data/tracker.db
LOG_LEVEL=INFO

# ── Ончейн-доступ ──────────────────────────────────────────────
# Etherscan v2: один ключ на все сети, Polygon запрашивается через
# chainid=137. Бесплатный тариф: 5 запросов/с, 100 000 в сутки.
# Взять: etherscan.io -> ник справа вверху -> API Keys -> Add
ETHERSCAN_API_KEY=

# Alchemy: архивная история логов и поток сделок в реальном времени.
# Взять: alchemy.com -> Create new app -> Polygon PoS Mainnet.
# HTTPS нужен для истории, WSS — чтобы видеть сделки на 5 минут раньше,
# чем их отдаёт Data API.
ALCHEMY_HTTP_URL=
ALCHEMY_WSS_URL=
